TELEM_API_KEY=
TAVILY_API_KEY=

# Any OpenAI-compatible chat endpoint. Per-role values override the shared ones.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
SEARCHER_MODEL=terra-6.1
SEARCHER_EFFORT=high
IMPROVER_MODEL=gpt-6-astra
IMPROVER_EFFORT=medium
# Judge for Wikidata-gap checks; keep it out of the improver's model family.
JUDGE_MODEL=terra-6.1
JUDGE_EFFORT=low
# Frontier model the system is compared against (python -m rsis compare), e.g. Opus or GPT Astra.
FRONTIER_MODEL=claude-opus-5-5
FRONTIER_EFFORT=high

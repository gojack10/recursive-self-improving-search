TELEM_API_KEY=
TELEM_BASE_URL=https://hack.telem.ai/api/router

# Optional API route: use plain model IDs instead of pi: IDs to enable these.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
SEARCHER_MODEL=pi:openai-codex/gpt-6.1-terra
SEARCHER_EFFORT=high
IMPROVER_MODEL=pi:openai-codex/gpt-6-astra
IMPROVER_EFFORT=medium
# Same-family judge: separate evidence check, not independent model-family confirmation.
JUDGE_MODEL=pi:openai-codex/gpt-6-sol
JUDGE_EFFORT=low
# Frontier model the system is compared against (python -m rsis compare), e.g. Opus or GPT Astra.
FRONTIER_MODEL=pi:openai-codex/gpt-6-astra
FRONTIER_EFFORT=medium
